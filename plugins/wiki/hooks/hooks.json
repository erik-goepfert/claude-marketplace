{
  "description": "Wiki: block edits outside the claude worktree, sync before wiki access, sync after a turn that changed the wiki.",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Read|Grep|Glob|Edit|Write|MultiEdit|NotebookEdit|Bash",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${CLAUDE_PLUGIN_ROOT}/hooks/wiki_hook.py\" pre",
            "timeout": 240
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${CLAUDE_PLUGIN_ROOT}/hooks/wiki_hook.py\" stop",
            "timeout": 30
          }
        ]
      }
    ]
  }
}
