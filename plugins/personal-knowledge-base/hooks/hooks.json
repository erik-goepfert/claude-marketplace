{
  "description": "Personal knowledge base: block edits outside the claude worktree, sync before access, sync after a turn that changed it.",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Read|Grep|Glob|Edit|Write|MultiEdit|NotebookEdit|Bash",
        "hooks": [
          {
            "type": "command",
            "command": "/usr/bin/python3 \"${CLAUDE_PLUGIN_ROOT}/hooks/personal_knowledge_base_hook.py\" pre",
            "timeout": 240
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "/usr/bin/python3 \"${CLAUDE_PLUGIN_ROOT}/hooks/personal_knowledge_base_hook.py\" stop",
            "timeout": 30
          }
        ]
      }
    ]
  }
}
